# ===== Copy this file to ".env" and fill in the values =====

# ---------- Autoline ----------
AUTOLINE_BASE_URL=https://ykacentralapi.almoayyed.com.bh/prod/api/v1
# Endpoint path from IT (12 Nov 2026): .../parts/shopify/LoadPartsStockRecord
AUTOLINE_PARTS_PATH=parts/shopify
AUTOLINE_SESSION_ID=12345
# Main rooftop: Price1, blockSale and description come from here (business: SOC1P_PH)
AUTOLINE_ROOFTOP_ID=SO01P_PH
AUTOLINE_USER_ID=ADMIN-YK
# OPEN QUESTION 3: if IT gives an API key/token, put extra headers here as JSON
# Example: AUTOLINE_EXTRA_HEADERS={"x-api-key":"abc123"}
AUTOLINE_EXTRA_HEADERS=
AUTOLINE_TIMEOUT_MS=20000
# seconds to wait before each retry
AUTOLINE_RETRY_DELAYS=1,4,16

# Which Autoline quantity is used as stock (business: total)
#   total     = totalStockQty
#   prime1    = quantity_1 (Prime1) only
#   prime1-3  = quantity_1 + quantity_2 + quantity_3
STOCK_SOURCE=total

# Selling price (business: Price1)
#   price1          = price = Price1, compare-at price is not touched
#   price1_special  = if specialPrice > 0: price = specialPrice, compare-at = Price1
PRICE_MODE=price1

# Description sync stays OFF until business approves (true/false)
DESCRIPTION_SYNC_ENABLED=false

# ---------- Shopify ----------
SHOPIFY_STORE=ykalmoayyed-test-store.myshopify.com
# Option A (new, 2026+): app made in Dev Dashboard -> Settings -> Client ID / Client secret
# The app gets a 24-hour token itself and refreshes it automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B (only if an OLD legacy custom app already exists): its shpat_ token. Leave empty if using Option A.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-07
# Pickup order re-check webhook: app 'API secret key' (Shopify admin -> app -> API credentials)
SHOPIFY_WEBHOOK_SECRET=
PICKUP_RECHECK=true
PICKUP_ALERT_TAG=pickup-stock-alert
# Which Autoline rooftop fills which Shopify location (stock). Comma separated ROOFTOP=location id.
# Get location ids with: npm run test-shopify
#   SOC1P_PH -> online / delivery location (create "Online Warehouse" in Shopify if allowed)
#   SOE4P_PH -> Manama Showroom (pickup)      SOE3P_PH -> Gudaibiya Showroom (pickup)
LOCATION_STOCK_MAP=SOE4P_PH=gid://shopify/Location/84407025889
# Pickup outlets: delivery-only parts get stock 0 here, so pickup is not offered for them
OUTLET_ROOFTOPS=SOE4P_PH
# Delivery-only: Shopify tag, or product types (comma separated), or Y in parts-list.csv
DELIVERY_ONLY_TAG=delivery-only
DELIVERY_ONLY_PRODUCT_TYPES=
# zero = outlet stock 0 (reversible) | deactivate = remove outlet inventory (design doc; re-activated when no longer delivery-only)
DELIVERY_ONLY_ACTION=zero

# Which parts to sync: csv = parts-list.csv | tag = Shopify products tagged SYNC_TAG (design doc)
PARTS_SOURCE=csv
SYNC_TAG=autoline-sync

# Autoline part = franchise code + Shopify SKU (used when parts-list.csv has no autoline_part_number, or PARTS_SOURCE=tag)
#   1) product metafield autoline.franchise_code  2) brand (Vendor) in metaobject below / FRANCHISE_MAP  3) else UNMAPPED
FRANCHISE_METAOBJECT_TYPE=autoline_franchise
# Fallback brand list, e.g. Nikai=NK,Comfee=CO,Toshiba=TA|TH  (a brand with 2 codes needs the product metafield)
FRANCHISE_MAP=Admiral=AD,Comfee=CO,Fratelli=FT,Frettelli=FT,Glemgas=GG,EROS=HA,Indesit=ID,Ignis=IG,Nikai=NK,Panasonic=PA,Super General=SG,Samsung=SS,Toshiba=TA|TH|TV,Toshiba AC=TA,Toshiba HA=TH,Toshiba TV=TV,Westpoint=WT,White-Westinghouse=WW,Zamil Classic=ZC

# blockSale = Y:  zero = stock 0 at all locations + tag (design doc) | draft = product to Draft
BLOCK_SALE_ACTION=zero
BLOCKED_TAG=autoline-blocked

# Variant metafields autoline.sync_status / autoline.last_synced_at
STATUS_METAFIELDS=true
# Report a price change bigger than this (%)
PRICE_SWING_PERCENT=50
# Keep some stock back per rooftop, e.g. SOE4P_PH=1,SOE3P_PH=1
SAFETY_BUFFER=
# Only used if LOCATION_STOCK_MAP is empty: single location for the main rooftop
SHOPIFY_LOCATION_ID=


# ---------- Sync ----------
SYNC_INTERVAL_MINUTES=15
RECONCILIATION_TIME=02:00
TIMEZONE=Asia/Bahrain
CONCURRENCY=3
# false = no automatic runs (only manual Refresh / CLI)
AUTO_SYNC=true
# true = only log what WOULD change, write nothing to Shopify (good for first test)
DRY_RUN=false
PARTS_LIST_FILE=parts-list.csv

# ---------- Alerts ----------
OUTAGE_ALERT_MINUTES=60
# Optional: Teams / Slack / Google Chat incoming-webhook URL (receives {"text": "..."})
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=60

# ---------- Logs ----------
LOG_RETENTION_DAYS=365

# ---------- Dashboard ----------
PORT=3000
# 127.0.0.1 = only this computer can open the dashboard. Use 0.0.0.0 on a server behind a firewall.
HOST=127.0.0.1
# Long random password for the dashboard: http://localhost:3000/?token=ADMIN_TOKEN
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- v1.4 ----
# franchise = Autoline part = franchise code + SKU | sku = Shopify SKU already is the Autoline part number (e.g. NKUHD65SLEDT)
PART_KEY_MODE=franchise
# false = do not write Manama / Gudebiya stock to Shopify (pickup re-check still reads Autoline)
OUTLET_STOCK_SYNC=true
# Alert emails (Office 365: smtp.office365.com 587, Gmail: smtp.gmail.com 587 with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Delivery only by category (v1.5): MDA = delivery only, SDA = pickup + delivery. Mark products with: npm run apply-category -- file.csv --apply
DELIVERY_ONLY_TAG=MDA
# AC indoor + outdoor sold as one product: variant metafield autoline.part_number = "ADADS36T3T3CPCA-I+ADADS36T3T3CPCA-O"
#   price = sum of price1 + variant metafield autoline.installation_charge; stock = the lower of the two
# v1.6: website price = price1 + VAT % (price1 is without VAT). 0 = price1 as it is
PRICE_VAT_PERCENT=10
# v1.6: stock a product at Manama / Gudaibiya automatically if it is not set up there yet
STOCK_AT_ALL_LOCATIONS=true
# v1.7: products not in C1 but in a showroom -> Shopify 0 ("Arriving Soon") + listed in the daily email
NOT_IN_C1_ZERO=true
# v1.7: installation charge = Autoline part ZZCARR (C1 price1) added to products tagged "installation" (AC), then VAT
INSTALLATION_PART=ZZCARR
INSTALLATION_TAG=installation

# Check Shopify for new pickup orders every N minutes (no public URL / webhook needed). 0 = off.
PICKUP_POLL_MINUTES=3

# ---------- Dashboard login ----------
# First admin user(s), used ONLY on the very first start: "username:password:email" (comma between users).
# After that, add/remove users in the dashboard (Users page). Users are saved in users.json (passwords hashed).
DASHBOARD_USERS=
# Second step: a 6-digit code is emailed at every sign-in (needs SMTP above). true / false
LOGIN_EMAIL_OTP=true
# Hours before you have to sign in again
SESSION_HOURS=12
# Optional: only these IPs may open the dashboard (comma separated). Empty = any IP (login still required).
ALLOWED_IPS=
